# Copy to .env and adjust.

# Folder of notes on the host (mounted at /notes; the container edits notes as uid 1000).
NOTES_DIR=./notes

# Which host address to publish on. 127.0.0.1 = this machine only.
# Use your Tailscale IP to reach it from your tailnet, or 0.0.0.0 for every interface
# (Recall has no login: anyone who can reach the port can read and edit your notes).
RECALL_BIND=127.0.0.1
# Port on the host: open http://localhost:9999
RECALL_PORT=9999

# Every host name/IP you'll use in the browser besides localhost (e.g. the Tailscale IP).
RECALL_ALLOWED_HOSTS=
