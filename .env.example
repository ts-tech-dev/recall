# Copy to .env and adjust.

# Folder of notes on the host (mounted at /notes; the container edits notes as uid 1000).
NOTES_DIR=./notes

# Which host address to publish on. 127.0.0.1 = this machine only.
# Use your Tailscale IP to reach it from your tailnet, or 0.0.0.0 for every interface
# Recall has no user accounts: anyone with its key (in `docker logs recall`, or RECALL_KEY below) can read and
# edit your notes, and plain HTTP sends it unencrypted over the network.
RECALL_BIND=127.0.0.1
# Port on the host: open the address in `docker logs recall` once (http://localhost:9999/?key=…)
RECALL_PORT=9999

# Every host name/IP you'll use in the browser besides localhost (e.g. the Tailscale IP).
RECALL_ALLOWED_HOSTS=

# Optional: your own access key (make it long and random) instead of the one Recall makes in the data volume.
RECALL_KEY=
